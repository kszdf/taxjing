.post-entry { border-color: #388bfd; }
.entry-title { font-size: 32rpx; font-weight: 600; }
.entry-sub { font-size: 24rpx; margin-top: 8rpx; }
.mini-btn { padding: 10rpx 28rpx; margin: 0; }

/* 我的社区资产（M2） */
.my-bar { display: flex; justify-content: space-around; padding: 24rpx 12rpx; background: #141c26; }
.my-item { text-align: center; flex: 1; }
.my-num { font-size: 36rpx; font-weight: 700; color: #e6edf3; }
.my-item .text2 { font-size: 22rpx; margin-top: 6rpx; }

.bounty-row { flex-direction: column; align-items: flex-start; gap: 10rpx; }
.bounty-input { width: 200rpx; min-height: 0; height: 70rpx; padding: 10rpx 20rpx; margin-bottom: 0; text-align: center; }

.input {
  width: 100%;
  background: #0f1419;
  border: 1rpx solid #2a3645;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  color: #e6edf3;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.area { min-height: 200rpx; }
.ph { color: #8b98a5; }
.form-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.picker { color: #388bfd; font-size: 26rpx; padding: 10rpx 0; }
.anon { gap: 12rpx; }
.anon .text2 { font-size: 26rpx; }
.submit { margin-top: 8rpx; }

.tabs { gap: 8rpx; margin: 8rpx 0 16rpx; }
.tab {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #1a2330;
  border: 1rpx solid #2a3645;
  color: #8b98a5;
  font-size: 26rpx;
}
.tab-on { color: #fff; background: #388bfd; border-color: #388bfd; }

.scene-bar { white-space: nowrap; margin-bottom: 16rpx; }
.scene-chip {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #1a2330;
  border: 1rpx solid #2a3645;
  color: #8b98a5;
  font-size: 24rpx;
}
.scene-on { color: #388bfd; border-color: #388bfd; }

.post .p-title { font-size: 30rpx; line-height: 1.6; margin-top: 14rpx; }
.post .meta { margin-top: 16rpx; font-size: 24rpx; }
.meta-r { gap: 20rpx; }
.m-l { margin-left: 20rpx; }
.time { font-size: 22rpx; }

.tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 10rpx;
  white-space: nowrap;
}
.tag.scene { background: rgba(56,139,253,0.15); color: #388bfd; }
.tag.ok { background: rgba(63,185,80,0.15); color: #3fb950; }
.tag.pin { background: rgba(210,153,34,0.15); color: #d29922; }
.tag.bounty { background: rgba(210,153,34,0.18); color: #d29922; }
