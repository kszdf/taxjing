page { height: 100%; }

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #0f1419;
}
.topbar {
  flex: 0 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
}
.clear { color: #388bfd; font-size: 26rpx; padding: 8rpx 16rpx; }
.text2 { color: #8b98a5; font-size: 26rpx; }
.row { display: flex; }
.between { justify-content: space-between; align-items: center; }

.chat { flex: 1; padding: 0 24rpx; box-sizing: border-box; }

.empty { padding-top: 50rpx; }
.empty-t { font-size: 36rpx; font-weight: 600; color: #e6edf3; margin-bottom: 12rpx; }
.empty-s { font-size: 26rpx; color: #8b98a5; line-height: 1.6; margin-bottom: 28rpx; }
.chip {
  display: inline-block;
  background: #1a2330;
  border: 1rpx solid #2a3645;
  color: #c9d4e0;
  font-size: 26rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  margin: 0 16rpx 16rpx 0;
}

.msg { margin-bottom: 24rpx; display: flex; }
.msg.me { justify-content: flex-end; }
.bubble { max-width: 88%; border-radius: 16rpx; padding: 20rpx; box-sizing: border-box; }
.me-b { background: #388bfd; color: #ffffff; font-size: 28rpx; line-height: 1.6; }
.ai-b { background: #1a2330; border: 1rpx solid #2a3645; }

.badge-row { margin-bottom: 16rpx; }
.badge { font-size: 24rpx; padding: 8rpx 16rpx; border-radius: 999rpx; }
.badge-blue { background: rgba(56,139,253,0.15); color: #388bfd; }
.badge-yellow { background: rgba(210,153,34,0.18); color: #d29922; }
.badge-gray { background: rgba(139,152,165,0.15); color: #8b98a5; }

.answer { line-height: 1.7; color: #e6edf3; font-size: 28rpx; white-space: pre-wrap; }
.ref-block { margin-top: 20rpx; border-top: 1rpx dashed #2a3645; padding-top: 16rpx; }
.ref-title { color: #3fb950; font-size: 26rpx; margin-bottom: 10rpx; }
.ref-item { color: #8b98a5; font-size: 24rpx; line-height: 1.7; }

.inputbar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #141b23;
  border-top: 1rpx solid #2a3645;
}
.q {
  flex: 1;
  height: 72rpx;
  background: #0f1419;
  border: 1rpx solid #2a3645;
  border-radius: 999rpx;
  padding: 0 24rpx;
  color: #e6edf3;
  font-size: 28rpx;
}
.ph { color: #8b98a5; }
.send { margin: 0 0 0 16rpx; background: #388bfd; color: #ffffff; font-size: 28rpx; }
