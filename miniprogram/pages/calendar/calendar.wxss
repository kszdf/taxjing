.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #0f1419;
}
.header {
  padding: 16rpx 8rpx 24rpx;
}
.h-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #e6edf3;
}
.h-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8b98a5;
}
.loading, .empty {
  text-align: center;
  color: #8b98a5;
  padding: 80rpx 0;
  font-size: 28rpx;
}
.tip {
  margin-bottom: 16rpx;
}
.card {
  background: #1a2330;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border-left: 8rpx solid #388bfd;
}
.card.urgent {
  border-left-color: #f85149;
}
.card.near {
  border-left-color: #d29922;
}
.row.between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.d-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #e6edf3;
  flex: 1;
  margin-right: 16rpx;
}
.d-badge {
  font-size: 24rpx;
  color: #388bfd;
  background: rgba(56,139,253,0.12);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}
.d-badge.urgent {
  color: #f85149;
  background: rgba(248,81,73,0.12);
}
.d-badge.near {
  color: #d29922;
  background: rgba(210,153,34,0.12);
}
.d-period {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #c9d1d9;
}
.d-due {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8b98a5;
}
.d-note {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #8b98a5;
  line-height: 1.5;
}
.footer-note {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #6e7681;
  line-height: 1.6;
  text-align: center;
}
.sub-btn {
  display: inline-block;
  margin: 0 0 0 16rpx;
  font-size: 22rpx;
  line-height: 2.2;
  padding: 0 24rpx;
  background: #388bfd;
  color: #fff;
  border-radius: 24rpx;
  border: none;
  vertical-align: middle;
}
.sub-btn::after {
  border: none;
}
