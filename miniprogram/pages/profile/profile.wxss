.profile-head { display: flex; align-items: center; }
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #2a3645;
  text-align: center;
  line-height: 96rpx;
  font-size: 48rpx;
  margin-right: 24rpx;
}
.p-name { font-size: 32rpx; font-weight: bold; color: #e6edf3; }
.p-openid { margin-top: 8rpx; font-size: 22rpx; }
.stat-row { display: flex; }
.stat { flex: 1; text-align: center; }
.stat-num { font-size: 36rpx; font-weight: bold; color: #388bfd; }
.menu { padding: 0; }
.menu-item { padding: 28rpx 24rpx; }
