# 税镜 后端环境变量模板
# 用法：复制本文件为 .env 后填写真实值（.env 不入库、不提交）
# 本地开发可留空用默认值；生产部署【必须】填写并设置 APP_ENV=production

# 运行环境：development（默认本地演示） / production（公网部署，强制强随机 token）
APP_ENV=development

# 运营后台令牌（建议 24+ 位随机串，生成：python -c "import secrets;print(secrets.token_hex(24))"）
ADMIN_TOKEN=
# 定时任务触发令牌（征期提醒推送等，同上生成方式）
CRON_TOKEN=

# 运营/定时接口来源 IP 白名单（逗号分隔，默认仅本机）。
# 生产填公司办公出口 IP，例如：ADMIN_ALLOWED_IPS=127.0.0.1,203.0.113.10
ADMIN_ALLOWED_IPS=127.0.0.1,::1

# 反代架构下设为 1，后端改读 X-Forwarded-For 真实 IP（需 nginx 用覆盖式注入，见部署指南）
TRUST_PROXY=0

# 微信订阅消息（征期提醒）
WX_APPID=wx1dbe0f380c108b9f
WX_APPSECRET=
WX_SUBSCRIBE_TMPL_ID=

# 企微客服
WX_CORPID=
WX_KEFU_QR=

# 大模型（不配则 AI 问答走规则兜底）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
